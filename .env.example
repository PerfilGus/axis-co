# Copie para .env.local (que não vai para o git). Na Vercel, cadastre em
# Project > Settings > Environment Variables. Nunca commite valores.

# --- Banco (Neon, via integração da Vercel) ---
# Conexão com pool, usada pelo app.
DATABASE_URL=
# Conexão direta, usada só pelas migrations (npm run db:migrar).
DATABASE_URL_UNPOOLED=

# --- Autenticação (Better Auth) ---
# Segredo aleatório de 32+ bytes: openssl rand -base64 32. Um por ambiente.
BETTER_AUTH_SECRET=
# Endereço público do sistema. Local: http://localhost:3000
BETTER_AUTH_URL=

# --- Arquivos privados (Vercel Blob, store com acesso private) ---
BLOB_READ_WRITE_TOKEN=

# --- Rotinas agendadas (Vercel Cron) ---
# Segredo aleatório de 32+ bytes: openssl rand -base64 32. A Vercel o envia como
# "Authorization: Bearer" nas chamadas do cron; sem ele, /api/cron recusa tudo.
CRON_SECRET=

# --- Seed do administrador inicial (só na máquina de quem roda o seed) ---
# npm run db:seed. A senha é provisória: troca obrigatória no primeiro acesso.
ADMIN_INICIAL_NOME=
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_SENHA=
