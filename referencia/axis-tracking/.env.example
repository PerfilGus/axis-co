# Copie para .env.local (que NÃO vai pro git) para rodar `vercel dev` localmente.
# Em produção, defina tudo isso no painel da Vercel > Project > Settings > Environment Variables.

# --- Banco (Vercel Postgres / Neon) ---
# Preenchido automaticamente ao conectar o store na Vercel. Localmente: `vercel env pull .env.local`.
POSTGRES_URL=

# --- Correios CWS (opcional; sem isso o rastreio roda em modo degradado) ---
# Ambiente: HOMOLOGACAO ou PRODUCAO. Credenciais de homologação são OUTRAS —
# as do contrato real só funcionam em PRODUCAO.
CORREIOS_ENV=PRODUCAO
# Identificador do usuário CWS. Em contrato PJ é o CNPJ, só dígitos.
CORREIOS_USER=
# Código de acesso ("token") gerado no portal CWS dos Correios para esse usuário.
CORREIOS_ACCESS_CODE=
# Número do cartão de postagem do contrato (com o zero à esquerda).
CORREIOS_CARTAO_POSTAGEM=
